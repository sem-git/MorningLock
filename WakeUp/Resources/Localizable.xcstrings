    "방해 앱을 잠그고 외출 준비에 집중해보세요" : {
      "comment" : "AlarmManager, NotificationManager",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock distracting apps. Focus on getting ready."
          }
        },
        "ja" : {
          "stringUnit" : {
